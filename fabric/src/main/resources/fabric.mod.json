{
  "schemaVersion": 1,
  "id": "precast_structure",
  "version": "${version}",
  "name": "Pre-cast Structure",
  "description": "Scan framed builds into blueprints, print them into pre-cast structure items, and place the structure with a hologram deploy preview.",
  "authors": ["oOBoomberOo"],
  "contact": {
    "homepage": "https://github.com/oOBoomberOo/precast-structure",
    "sources": "https://github.com/oOBoomberOo/precast-structure",
    "issues": "https://github.com/oOBoomberOo/precast-structure/issues"
  },
  "license": "MIT",
  "icon": "assets/precast_structure/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.ooboomberoo.precaststructure.fabric.PrecastStructureFabric"
    ],
    "client": [
      "io.github.ooboomberoo.precaststructure.fabric.PrecastStructureFabricClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "architectury": ">=9.2.14",
    "fabric-api": "*",
    "cloth-config": ">=11"
  },
  "suggests": {
    "modmenu": "*"
  },
  "accessWidener": "precast_structure.accesswidener"
}
